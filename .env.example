APP_NAME=Rentivo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rentivo.rent

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentivo_db
DB_USERNAME=rentivo_user
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=mail.rentivo.rent
MAIL_PORT=465
MAIL_USERNAME=rentivo@rentivo.rent
MAIL_PASSWORD="Rentivo@123"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="rentivo@rentivo.rent"
MAIL_FROM_NAME="${APP_NAME}"

# ── Khalti Payment ──────────────────────────────────────────────────
KHALTI_PUBLIC_KEY=your_khalti_public_key_here
KHALTI_SECRET_KEY=your_khalti_secret_key_here
KHALTI_BASE_URL=https://khalti.com/api/v2
KHALTI_FAKE_MODE=false

# ── Rentivo Settings ────────────────────────────────────────────────
DEFAULT_UNLOCK_FEE=50
REFERRAL_REWARD=25

# ── Map Defaults ────────────────────────────────────────────────────
MAP_DEFAULT_LAT=27.7172
MAP_DEFAULT_LNG=85.3240
MAP_DEFAULT_ZOOM=13
