<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1E;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#111113;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="icon" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F97316;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#C2410C;stop-opacity:0.4" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="600" height="400" fill="url(#bg)" />

  <!-- Pattern -->
  <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
    <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>
  </pattern>
  <rect width="600" height="400" fill="url(#grid)" />

  <!-- House icon centered -->
  <g transform="translate(300,200)" opacity="0.35">
    <!-- Roof -->
    <polygon points="0,-80 -70,-20 70,-20" fill="url(#icon)" />
    <!-- Body -->
    <rect x="-50" y="-20" width="100" height="70" fill="url(#icon)" />
    <!-- Door -->
    <rect x="-18" y="15" width="36" height="35" fill="#0A0A0B" opacity="0.6" rx="4"/>
    <!-- Window left -->
    <rect x="-42" y="-8" width="22" height="22" fill="#0A0A0B" opacity="0.5" rx="3"/>
    <!-- Window right -->
    <rect x="20" y="-8" width="22" height="22" fill="#0A0A0B" opacity="0.5" rx="3"/>
  </g>

  <!-- Label -->
  <text x="300" y="320" text-anchor="middle"
        font-family="DM Sans, sans-serif" font-size="14"
        fill="rgba(255,255,255,0.2)" letter-spacing="2">
    NO IMAGE
  </text>
</svg>
